# Server Configuration
PORT=3333

# Telegram Bot Configuration
# Get your token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Default Chat ID (optional - users can also interact directly with the bot)
# Get your chat ID from https://t.me/userinfobot or start the bot
TELEGRAM_CHAT_ID=your_chat_id_here

# Price Polling Interval (in seconds)
PRICE_CHECK_INTERVAL_SECONDS=5

# Optional Custom Gold API Key (if using goldapi.io or metals-api, otherwise uses free multi-source feeds)
GOLD_API_KEY=
